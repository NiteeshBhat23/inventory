# Copy to .env.local and fill in from your Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The backend API. When testing from your phone on the same Wi-Fi, use your
# laptop's LAN IP instead of localhost, e.g. http://192.168.1.23:8000/api
# On Vercel (single-project deploy), set this to /api (relative, same-origin).
VITE_API_BASE_URL=http://localhost:8000/api
