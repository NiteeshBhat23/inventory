# Copy this file to .env and fill in real values.
# Get these from your Supabase project: Settings -> API, and Settings -> Database.

# Postgres connection string (Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Settings -> General -> Project URL (used to fetch the JWKS for verifying login tokens)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Comma-separated list of origins allowed to call this API (add your phone's dev URL if needed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
