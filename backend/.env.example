# Copy this file to .env and fill in real values.
# Get these from your Supabase project: Settings -> API, and Settings -> Database.

# Postgres connection string (Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Settings -> General -> Project URL (used to fetch the JWKS for verifying login tokens)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Comma-separated list of origins allowed to call this API (add your phone's dev URL if needed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Bill scanning (Phase 2) — optional ----------
# Get a free key with no credit card at https://aistudio.google.com/apikey
# (sign in with a Google account, "Create API key"). Leave unset and the
# /bills/extract endpoint returns a clean 503 — every other feature, and the
# app itself, works fine without it.
# GEMINI_API_KEY=your-gemini-api-key

# Model id, only worth changing if Google deprecates this one. Vision-capable,
# free-tier eligible (Aug 2026), no billing account needed. gemini-2.5-flash-lite
# is no longer issued to new API keys — Google's own 404 on that model points
# projects at this one instead.
# GEMINI_MODEL=gemini-3.5-flash-lite
