{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "inventory/frontend", "--", "--host"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "inventory/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--app-dir", "inventory/backend"],
      "port": 8000
    }
  ]
}
